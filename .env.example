# ── El backend ──────────────────────────────────────────────────────────────────────────────
# El navegador le habla DIRECTO: ya no hay proxy que reenvie ni llave de API que esconder, porque
# la credencial que viaja es el token de la persona que entro y ese si le pertenece.
#
# En un despliegue esta variable es obligatoria. Sin ella las peticiones irian a localhost desde el
# navegador de otra persona, y el sintoma es un error de red que parece "el servicio esta caido".
#
# Y del lado del backend hace falta el permiso correspondiente: DECLARAS_CORS_ORIGINS con este
# dominio, o el navegador descarta las respuestas aunque lleguen bien.
VITE_API_URL=http://127.0.0.1:8000

# El numero al que escribe el boton principal. Solo digitos, con indicativo de pais y sin signos.
# Sin el, el build avisa y el boton lleva a la guia en vez de quedarse muerto. El sitio
# funciona igual, pero el embudo queda a medias: la conversacion es el producto.
VITE_WHATSAPP=573001234567

# El dominio, para canonicas, sitemap y tarjetas al compartir.
VITE_SITIO_URL=https://declaras.co

# ── Ingreso del contador (Supabase Auth) ────────────────────────────────────────────────────
# Estas SI van al navegador, y esta bien: la llave anonima es el identificador publico del
# proyecto, hecho para vivir en un cliente. Por si sola no lee ni escribe nada — lo que autoriza es
# el token que Supabase emite despues de que alguien prueba quien es con su clave.
#
# Y en este proyecto el Data API esta APAGADO, asi que la llave anonima no tiene ni una tabla a la
# que preguntarle: solo sirve para el login. Encender el Data API la volveria capaz de leer lo que
# permitan las politicas de RLS, y aca NO HAY POLITICAS — encenderlo obliga a escribirlas primero.
#
# Sin estas dos, `/login` dice que el ingreso no esta configurado y la consola sigue funcionando
# con la clave compartida del middleware. No se rompe nada; simplemente no hay sesion de persona.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Medicion de anuncios (opcional) ─────────────────────────────────────────────────────────
# Sin estas variables NO se carga ningun script de Google, no se guarda nada en el navegador y no
# sale ni una peticion: el sitio funciona igual y el codigo de medicion se poda del paquete.
#
# Los dos primeros valores salen de la accion de conversion en Google Ads. Al crearla, Google
# muestra una linea del tipo:
#     gtag('event', 'conversion', {'send_to': 'AW-123456789/AbC-D_efGhIjKlMnOp'})
# La parte de antes de la barra es el ID y la de despues es la etiqueta.
#
# VAN LAS DOS O NINGUNA: con una sola, el build falla a proposito. Media configuracion no mide y
# el sintoma seria una campana gastando sin registrar una sola conversion.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Google Analytics 4, independiente de lo anterior. Sirve para leer el embudo por fuente de
# trafico aunque nunca se pague un anuncio.
VITE_GA4_ID=

# ── PostHog: embudo y grabacion de sesion (opcional) ────────────────────────────────────────
# Sin la clave no se descarga ni el paquete: queda en su propio archivo y nunca se pide.
#
# LA GRABACION ENMASCARA TODO LO QUE SE TECLEE (`maskAllInputs`), y no es negociable: en el
# flujo de consulta la gente escribe su cedula y la CLAVE DE SU CUENTA DE LA DIAN. Se ve por
# donde se movio y donde se fue, no lo que escribio.
#
# La consola y el ingreso quedan fuera enteros, igual que del resto de la medicion.
VITE_POSTHOG_KEY=
# Solo si el proyecto esta en la region europea: https://eu.i.posthog.com
VITE_POSTHOG_HOST=
