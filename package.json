    "build": "node scripts/sitemap.mjs && vite build && vite build --ssr src/entrada-servidor.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/auditar-seo.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "sitemap": "node scripts/sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "seo": "node scripts/auditar-seo.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "playwright": "^1.62.1"
