{
  "name": "clara-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "estilos": "node scripts/revisar-estilos.mjs",
